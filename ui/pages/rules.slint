import { ScrollView, Button, LineEdit, ComboBox, Palette } from "std-widgets.slint";

export struct RuleEdit {
    id: string,
    name: string,
    message: string,
    which-timer: string,
    trigger-if: string,
    trigger-hours: string,
    trigger-minutes: string,
    tolerance-hours: string,
    tolerance-minutes: string,
}

// `text` cannot stay bound to a model value because typing breaks the binding.
// The wrapper tracks the model value separately and pushes external updates
// into the editable text.
component RuleLineEdit inherits LineEdit {
    in property <string> value;
    min-width: 0;
    init => { self.text = self.value; }
    changed value => {
        if self.text != self.value {
            self.text = self.value;
        }
    }
}

component RuleComboBox inherits ComboBox {
    in property <string> display;
    init => { self.current-value = self.display; }
    changed display => {
        if self.current-value != self.display {
            self.current-value = self.display;
        }
    }
}

export component RulesPage inherits Rectangle {
    in property <[RuleEdit]> rules;

    callback field-changed(int, string, string);
    callback add-rule();
    callback remove-rule(int);
    callback save-rules();
    callback reset-rules();

    ScrollView {
        width: parent.width;
        height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: min(parent.width, 58rem);
            x: (parent.width - self.width) / 2;
            padding: 1rem;
            spacing: 1rem;
            alignment: start;

            for rule[index] in root.rules: Rectangle {
                background: Palette.alternate-background;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 0.5rem;

                VerticalLayout {
                    padding: 1rem;
                    spacing: 0.5rem;

                    HorizontalLayout {
                        Text {
                            text: "Rule \{index + 1}";
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Delete";
                            clicked => { root.remove-rule(index); }
                        }
                    }

                    Text { text: "Name"; }
                    RuleLineEdit {
                        value: rule.name;
                        edited(value) => { root.field-changed(index, "name", value); }
                    }

                    Text { text: "Message"; }
                    RuleLineEdit {
                        value: rule.message;
                        edited(value) => { root.field-changed(index, "message", value); }
                    }

                    Text { text: "Timer"; }
                    RuleComboBox {
                        model: ["Working timer", "Sleep timer", "System clock"];
                        display: rule.which-timer == "working" ? "Working timer"
                            : (rule.which-timer == "sleep" ? "Sleep timer" : "System clock");
                        selected(value) => {
                            root.field-changed(index, "which-timer",
                                value == "Working timer" ? "working"
                                : (value == "Sleep timer" ? "sleep" : "system"));
                        }
                    }

                    Text { text: "Condition"; }
                    RuleComboBox {
                        model: ["After", "Before", "At"];
                        display: rule.trigger-if == "more" ? "After"
                            : (rule.trigger-if == "less" ? "Before" : "At");
                        selected(value) => {
                            root.field-changed(index, "trigger-if",
                                value == "After" ? "more"
                                : (value == "Before" ? "less" : "same"));
                        }
                    }

                    Text { text: rule.which-timer == "system" ? "Time of day (HH:MM)" : "Trigger after"; }
                    HorizontalLayout {
                        spacing: 0.5rem;
                        RuleLineEdit {
                            value: rule.trigger-hours;
                            edited(value) => { root.field-changed(index, "trigger-hours", value); }
                        }
                        Text {
                            text: rule.which-timer == "system" ? ":" : "h";
                            vertical-alignment: center;
                        }
                        RuleLineEdit {
                            value: rule.trigger-minutes;
                            edited(value) => { root.field-changed(index, "trigger-minutes", value); }
                        }
                        if rule.which-timer != "system": Text {
                            text: "m";
                            vertical-alignment: center;
                        }
                    }
                    if rule.which-timer == "system": Text {
                        text: "Compares with the current clock time, not elapsed time. Tolerance is a duration.";
                        wrap: word-wrap;
                        opacity: 0.7;
                    }

                    Text { text: "Tolerance"; }
                    HorizontalLayout {
                        spacing: 0.5rem;
                        RuleLineEdit {
                            value: rule.tolerance-hours;
                            edited(value) => { root.field-changed(index, "tolerance-hours", value); }
                        }
                        Text { text: "h"; vertical-alignment: center; }
                        RuleLineEdit {
                            value: rule.tolerance-minutes;
                            edited(value) => { root.field-changed(index, "tolerance-minutes", value); }
                        }
                        Text { text: "m"; vertical-alignment: center; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 1rem;

                Button {
                    text: "Add rule";
                    clicked => { root.add-rule(); }
                }
                Button {
                    text: "Reset to defaults";
                    clicked => { root.reset-rules(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Save";
                    clicked => { root.save-rules(); }
                }
            }
        }
    }
}
