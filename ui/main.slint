import { Palette } from "std-widgets.slint";
import { HomePage, TimelineDay, ReportItem } from "pages/home.slint";
import { RulesPage, RuleEdit } from "pages/rules.slint";
import { SettingsPage } from "pages/settings.slint";
import { AboutPage } from "pages/about.slint";
import { MenuBar } from "components/menu.slint";
import {
    Report,
    ReportSeverity,
    WarningBanner,
    ErrorDialog,
    FatalScreen,
} from "components/reporter.slint";
import {
    ManualBedtimeDialog,
    CorrectionDialog,
} from "components/sleep_dialogs.slint";

export component MainWindow inherits Window {
    in-out property <int> current-page: 0;

    in property <string> app-version;
    in property <bool> is-mobile;

    in property <Report> active-report;
    in property <int> active-report-id;
    in property <bool> report-visible;

    property <bool> compact-window: root.width < 960px;
    property <Orientation> orientation: root.compact-window ? vertical : horizontal;

    callback page-changed(int);
    callback open-url(string);
    callback report-dismissed(int);
    callback fatal-quit();
    callback tick();

    Timer {
        interval: 1s;
        triggered => { root.tick(); }
    }

    changed settings-theme => {
        Palette.color-scheme = root.settings-theme == "Dark" ? ColorScheme.dark
            : root.settings-theme == "Light" ? ColorScheme.light : ColorScheme.unknown;
    }

    in property <string> today-working-hour;
    in property <string> week-working-hour;
    in property <string> max-working-hour;

    in property <string> today-sleeping-hour;
    in property <string> week-sleeping-hour;
    in property <string> min-sleeping-hour;

    in property <int> max-working-time;
    in property <int> current-working-time;

    in property <int> max-sleeping-time;
    in property <int> current-sleeping-time;

    in-out property <bool> work-running;
    in-out property <bool> work-paused;
    in-out property <bool> sleeping;

    in property <[TimelineDay]> timeline-days;
    in property <string> week-label;
    in property <int> timeline-now-seconds;

    in property <string> average-work;
    in property <string> average-sleep;
    in property <int> streak;
    in property <int> work-goal-percent;
    in property <int> sleep-goal-percent;
    in property <[ReportItem]> recent-reports;

    in-out property <bool> sleep-need-bedtime;
    in property <bool> sleep-pending;
    in property <int> sleep-pending-seconds;
    in property <string> sleep-pending-hours;
    in property <string> sleep-pending-minutes;

    in-out property <[RuleEdit]> rule-edits;

    in-out property <string> settings-theme: "System";
    in-out property <bool> settings-notifications: true;
    in-out property <string> settings-quiet-start: "22:00";
    in-out property <string> settings-quiet-end: "07:00";
    in-out property <string> settings-week-start: "Monday";
    in-out property <string> settings-usual-work-hours: "07:30";

    callback on-work-pause();
    callback on-work-unpause();
    callback on-work-start();
    callback on-work-stop();

    callback on-sleep-start();
    callback on-sleep-wake-up();
    callback on-sleep-set-bedtime(string);
    callback on-sleep-cancel-bedtime();
    callback on-sleep-correct(string, string);
    callback on-sleep-discard();

    callback rule-field-changed(int, string, string);
    callback rule-add();
    callback rule-remove(int);
    callback rules-save();
    callback rules-reset();
    callback save-settings();

    FlexboxLayout {
        x: root.orientation == horizontal ? 0 : root.safe-area-insets.left;
        y: root.safe-area-insets.top;

        width: root.orientation == horizontal
             ? root.width : root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        height: root.height - root.safe-area-insets.bottom - root.safe-area-insets.top;

        flex-direction: root.orientation == horizontal ? row : column;
        flex-wrap: no-wrap;
        alignment: stretch;

        // Mobile-only page swipes. The menu bar stays outside this handler so
        // tab taps remain immediate and only the content area responds.
        sgr := SwipeGestureHandler {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            layout-order: root.orientation == horizontal ? 2 : 1;
            enabled: root.is-mobile;
            handle-swipe-left: root.current-page < 3;
            handle-swipe-right: root.current-page > 0;

            swiped => {
                if root.current-page < 3
                    && self.current-position.x < self.pressed-position.x - self.width / 8 {
                    root.current-page = root.current-page + 1;
                    root.page-changed(root.current-page);
                } else if root.current-page > 0
                    && self.current-position.x > self.pressed-position.x + self.width / 8 {
                    root.current-page = root.current-page - 1;
                    root.page-changed(root.current-page);
                }
            }

            page-clip := Rectangle {
                width: parent.width;
                height: parent.height;
                clip: true;

                page-row := HorizontalLayout {
                    property <length> page-position: -root.current-page * page-clip.width;
                    property <length> swipe-offset: 0;

                    width: page-clip.width * 4;
                    height: page-clip.height;
                    x: page-position + swipe-offset;

                    animate page-position {
                        duration: 220ms;
                        easing: ease-out;
                    }

                    states [
                        swiping when sgr.swiping: {
                            swipe-offset: sgr.current-position.x - sgr.pressed-position.x;
                            out {
                                animate swipe-offset {
                                    duration: 220ms;
                                    easing: ease-out;
                                }
                            }
                        }
                    ]

                    HomePage {
                        width: page-clip.width;
                        height: page-clip.height;
                        today-working-hour: root.today-working-hour;
                        week-working-hour: root.week-working-hour;
                        max-working-hour: root.max-working-hour;
                        today-sleeping-hour: root.today-sleeping-hour;
                        week-sleeping-hour: root.week-sleeping-hour;
                        min-sleeping-hour: root.min-sleeping-hour;
                        max-working-time: root.max-working-time;
                        current-working-time: root.current-working-time;
                        max-sleeping-time: root.max-sleeping-time;
                        current-sleeping-time: root.current-sleeping-time;
                        work-running <=> root.work-running;
                        work-paused <=> root.work-paused;
                        sleeping <=> root.sleeping;

                        timeline-days: root.timeline-days;
                        week-label: root.week-label;
                        timeline-now-seconds: root.timeline-now-seconds;
                        is-mobile: root.is-mobile;
                        average-work: root.average-work;
                        average-sleep: root.average-sleep;
                        streak: root.streak;
                        work-goal-percent: root.work-goal-percent;
                        sleep-goal-percent: root.sleep-goal-percent;
                        recent-reports: root.recent-reports;

                        on-work-pause => { root.on-work-pause() }
                        on-work-unpause => { root.on-work-unpause() }
                        on-work-start => { root.on-work-start() }
                        on-work-stop => { root.on-work-stop() }
                        on-sleep-start => { root.on-sleep-start() }
                        on-sleep-wake-up => { root.on-sleep-wake-up() }
                    }

                    RulesPage {
                        width: page-clip.width;
                        height: page-clip.height;
                        rules <=> root.rule-edits;

                        field-changed(index, field, value) => { root.rule-field-changed(index, field, value); }
                        add-rule => { root.rule-add(); }
                        remove-rule(index) => { root.rule-remove(index); }
                        save-rules => { root.rules-save(); }
                        reset-rules => { root.rules-reset(); }
                    }

                    SettingsPage {
                        width: page-clip.width;
                        height: page-clip.height;
                        theme <=> root.settings-theme;
                        notifications-enabled <=> root.settings-notifications;
                        quiet-start <=> root.settings-quiet-start;
                        quiet-end <=> root.settings-quiet-end;
                        week-start <=> root.settings-week-start;
                        usual-work-hours <=> root.settings-usual-work-hours;

                        save-settings => { root.save-settings(); }
                    }

                    AboutPage {
                        width: page-clip.width;
                        height: page-clip.height;
                        version: app-version;
                        open-url(url) => {
                            root.open-url(url)
                        }
                    }
                }
            }
        }

        MenuBar {
            layout-order: root.orientation == horizontal ? 1 : 2;
            orientation: root.orientation;
            preferred-width: 12rem;
            compact: root.orientation == vertical && root.width < 480px;
            current-page <=> root.current-page;
            label: "Rhythm";

            page-changed(index) => { page-changed(index); }

            items: [
                { icon: @image-url("../assets/icons/home.svg"), text: "Home" },
                { icon: @image-url("../assets/icons/page_info.svg"), text: "Rules" },
                { icon: @image-url("../assets/icons/settings.svg"), text: "Settings" },
                { icon: @image-url("../assets/icons/info.svg"), text: "About" }
            ];
        }
    }

    // Hidden focus target used to release text fields when switching pages.
    page-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    changed current-page => {
        page-focus.focus();
    }

    if root.sleep-need-bedtime: ManualBedtimeDialog {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        confirm(time) => { root.on-sleep-set-bedtime(time); }
        cancel => { root.on-sleep-cancel-bedtime(); }
    }

    if root.sleep-pending: CorrectionDialog {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        suggested-hours: root.sleep-pending-hours;
        suggested-minutes: root.sleep-pending-minutes;
        confirm(hours, minutes) => { root.on-sleep-correct(hours, minutes); }
        discard => { root.on-sleep-discard(); }
    }

    if root.report-visible && root.active-report.severity == ReportSeverity.Warning: WarningBanner {
        x: root.safe-area-insets.left + 1rem;
        y: root.safe-area-insets.top + 1rem;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right - 2rem;
        report: root.active-report;
        dismissed => { root.report-dismissed(root.active-report-id); }
    }

    if root.report-visible && root.active-report.severity == ReportSeverity.Error: ErrorDialog {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        report: root.active-report;
        dismissed => { root.report-dismissed(root.active-report-id); }
    }

    if root.report-visible && root.active-report.severity == ReportSeverity.Fatal: FatalScreen {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        report: root.active-report;
        quit => { root.fatal-quit(); }
    }
}
