import { Button, LineEdit, Palette } from "std-widgets.slint";

export component ManualBedtimeDialog inherits Rectangle {
    callback confirm(string);
    callback cancel;

    background: #00000080;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {}
    }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                min-width: 20rem;
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 0.5rem;

                VerticalLayout {
                    padding: 2rem;
                    spacing: 1rem;

                    Text {
                        text: "When did you go to bed?";
                        font-weight: 700;
                    }
                    Text { text: "Enter the time as HH:MM."; }

                    time-input := LineEdit {
                        text: "23:00";
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 1rem;

                        Button {
                            text: "Cancel";
                            clicked => { root.cancel(); }
                        }
                        Button {
                            text: "OK";
                            clicked => { root.confirm(time-input.text); }
                        }
                    }
                }
            }
        }
    }
}

export component CorrectionDialog inherits Rectangle {
    in property <string> suggested-hours;
    in property <string> suggested-minutes;
    callback confirm(string, string);
    callback discard;

    property <string> hours-text: root.suggested-hours;
    property <string> minutes-text: root.suggested-minutes;

    background: #00000080;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {}
    }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: min(24rem, root.width - 2rem);
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 0.5rem;

                VerticalLayout {
                    padding: 2rem;
                    spacing: 1rem;

                    Text {
                        text: "How long did you sleep?";
                        font-weight: 700;
                    }
                    Text {
                        text: "Based on your bedtime and wake-up times. Adjust it if you were awake during the night.";
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        spacing: 0.35rem;
                        Text { text: "Hours"; }
                        hours-input := LineEdit { text: root.hours-text; }
                    }
                    VerticalLayout {
                        spacing: 0.35rem;
                        Text { text: "Minutes"; }
                        minutes-input := LineEdit { text: root.minutes-text; }
                    }

                    FlexboxLayout {
                        flex-wrap: wrap;
                        alignment: end;
                        spacing: 0.75rem;

                        Button {
                            text: "Use computed";
                            clicked => { root.confirm(root.suggested-hours, root.suggested-minutes); }
                        }
                        Button {
                            text: "Discard";
                            clicked => { root.discard(); }
                        }
                        Button {
                            text: "Save";
                            clicked => { root.confirm(hours-input.text, minutes-input.text); }
                        }
                    }
                }
            }
        }
    }
}
